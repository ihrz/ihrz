[Unit]
Description=iHorizon Rust migration autonomous orchestrator
Documentation=file:@REPO@/ops/rust-migration/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@REPO@/ops/rust-migration/migrate-loop.sh
Restart=always
RestartSec=30
Nice=10
StandardOutput=journal
StandardError=journal
# Single instance: the loop takes a flock on .loop.lockfile (auto-released
# on crash); systemd Restart=always revives crashed loops.

[Install]
WantedBy=default.target
