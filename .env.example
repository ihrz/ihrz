# iHorizon configuration. Copy this file to `.env` and fill it in.
# Full guide: https://www.ihorizon.org/docs/self-hosting/configuration/
# Values with spaces or `#` go between double quotes. Inside a URL,
# special characters (@ : / # ?) must be percent-encoded (@ = %40, : = %3A).

# --- Discord ---
BOT_TOKEN=""
# Comma-separated Discord user IDs with full owner rights.
OWNERS=""
# true: prefix commands are triggered by mentioning the bot.
MESSAGE_COMMANDS_MENTION=true
# Prefix used when MESSAGE_COMMANDS_MENTION is false.
DEFAULT_PREFIX="?"
PHONE_PRESENCE=false

# --- Music (Lavalink) ---
# ws://password@host:port (wss:// for TLS). Several nodes: comma-separated.
# Optional query parameters: id, retryAmount, retryDelay.
# Example: ws://youshallnotpass@localhost:2333?id=main
LAVALINK_URL=""
LAVALINK_LOGS_CHANNEL_ID=""

# --- Database ---
# sqlite (default) | json | memory
# | postgres://user:password@host:5432/database
# | ws://login:password@host:port (HorizonDB, optional ?requestTimeoutMs=)
DATABASE_URL="sqlite"

# --- Core ---
DEV_MODE=false
BLACKLIST_PICTURE_URL=""
GUILD_LOGS_CHANNEL_ID=""
REPORT_CHANNEL_ID=""
# Comma-separated "{USER_ID_ONE}x{USER_ID_TWO}" couples always at 100% in /love.
ALWAYS_100=""

# --- Last.fm (scrobbler module, optional) ---
LASTFM_API_KEY=""
LASTFM_SHARED_SECRET=""

# --- HorizonGateway (official bot only, skip when self-hosting) ---
HORIZON_GATEWAY_URL="https://gateway.ihorizon.org"
HORIZON_GATEWAY_LOCAL_URL=""
HORIZON_API_TOKEN=""

# --- Notifiers and integrations (optional) ---
TWITCH_APPLICATION_ID=""
TWITCH_APPLICATION_SECRET=""
YOUTUBE_API_KEY=""
GITHUB_API_KEY=""
DB_STATS_CHANNEL=""

# --- Sharding ---
TOTAL_SHARDS="auto"
# 1: shards run from src instead of the dist/shard bundle.
IHORIZON_NO_BUNDLE=0

# --- Mail (optional) ---
SMTP_HOST=mail.example.com
SMTP_PORT=465 # 587 for no-SSL
SMTP_SECURE="true" # false for no-SSL
SMTP_USER="bot@example.com"
SMTP_PASS="Your Password"
OWNER_MAIL="owner@example.com"
EMAIL_WHEN_CHANGE_GUILD="false"

# --- Changelog PDF tool (tools/ChangelogPdf.ts only) ---
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/var/lib/flatpak/exports/bin/org.chromium.Chromium # or ~.local/share/flatpak/app/org.chromium.Chromium/current/active/export/bin/org.chromium.Chromium
