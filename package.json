{
	"name": "ihrz",
	"version": "2026.4.1",
	"description": "Official codebase of iHorizon Discord Bot.",
	"main": "./src/index.ts",
	"scripts": {
		"start": "bun ./src/index.ts",
		"auto-build": "npx tsc -w",
		"build": "npx tsc",
		"type:func": "bun run tools/Client_Func_Typator.ts",
		"type:lang": "bun run tools/LangsChecker-Tools.ts --type 2",
		"check:licence": "bun run tools/Licence_Workspace_Checker.ts",
		"check:lines": "bun run tools/Lines_Count.ts",
		"check:lc": "bun run check:lines",
		"dev": "echo \"Enjoy dev <3\" && bun run src/core/bot.ts"
	},
	"repository": {
		"type": "git",
		"url": "https://gitlab.com/ihrz/ihrz"
	},
	"keywords": [
		"discordbot"
	],
	"type": "module",
	"author": "Kisakay",
	"license": "CC-BY-NC-SA-4.0",
	"bugs": {
		"url": "https://gitlab.com/ihrz/ihrz/issues"
	},
	"homepage": "https://gitlab.com/ihrz/ihrz#readme",
	"dependencies": {
		"discord-html-transcripts": "3.2.0",
		"discord.js": "^14.25.1",
		"gifwrap": "^0.10.1",
		"jimp": "0.22.12",
		"jszip": "^3.10.1",
		"lavalink-client": "^2.9.10",
		"nodemailer": "^7.0.13",
		"puppeteer": "^24.40.0",
		"rss-parser": "^3.13.0",
		"typescript-eslint": "^8.57.2",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/bun": "^1.3.11",
		"@types/node": "^24.12.0",
		"@typescript-eslint/eslint-plugin": "^8.57.2",
		"@typescript-eslint/parser": "^8.57.2",
		"@types/nodemailer": "^7.0.11",
		"@types/xml2js": "^0.4.14",
		"eslint": "^9.39.4",
		"eslint-plugin-unused-imports": "^4.4.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	}
}