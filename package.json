{
	"name": "ihrz",
	"version": "2025.9.0",
	"description": "iHrz in ts!",
	"main": "./src/index.ts",
	"scripts": {
		"start": "bun ./src/index.ts",
		"auto-build": "npx tsc -w",
		"build": "npx tsc",
		"type:func": "bun run tools/Client_Func_Typator.ts",
		"type:lang": "bun run tools/LangsChecker-Tools.ts --type 2",
		"check:licence": "bun run tools/Licence_Workspace_Checker.ts",
		"check:lines": "bun run tools/Lines_Count.ts",
		"check:lc": "bun run check:lines"
	},
	"repository": {
		"type": "git",
		"url": "https://gitlab.com/ihrz/ihrz"
	},
	"keywords": [
		"discordbot"
	],
	"type": "module",
	"author": "Kisakay",
	"license": "CC-BY-NC-SA-4.0",
	"bugs": {
		"url": "https://gitlab.com/ihrz/ihrz/issues"
	},
	"homepage": "https://gitlab.com/ihrz/ihrz#readme",
	"dependencies": {
		"discord-html-transcripts": "^3.2.0",
		"discord.js": "^14.22.1",
		"dotenv": "^17.2.1",
		"gifwrap": "^0.10.1",
		"jimp": "0.22.12",
		"jszip": "^3.10.1",
		"lavalink-client": "^2.6.1",
		"puppeteer": "^24.18.0",
		"typescript-eslint": "^8.41.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.34.0",
		"@types/bun": "^1.2.21",
		"@types/node": "^24.3.0",
		"@typescript-eslint/eslint-plugin": "^8.41.0",
		"@typescript-eslint/parser": "^8.41.0",
		"eslint": "^9.34.0",
		"eslint-plugin-unused-imports": "^4.2.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2"
	}
}
