{
	"name": "ihrz",
	"version": "2025.7.4",
	"description": "iHrz in ts!",
	"main": "./src/index.js",
	"scripts": {
		"start": "node ./src/index.js",
		"auto-build": "npx tsc -w",
		"build": "npx tsc",
		"type:func": "bun run tools/Client_Func_Typator.ts",
		"type:lang": "bun run tools/LangsChecker-Tools.ts --type 2",
		"check:licence": "bun run tools/Licence_Workspace_Checker.ts",
		"check:lines": "bun run tools/Lines_Count.ts",
		"check:lc": "bun run check:lines"
	},
	"repository": {
		"type": "git",
		"url": "https://gitlab.com/ihrz/ihrz"
	},
	"keywords": [
		"discordbot"
	],
	"type": "module",
	"author": "Kisakay",
	"license": "CC-BY-NC-SA-4.0",
	"bugs": {
		"url": "https://gitlab.com/ihrz/ihrz/issues"
	},
	"homepage": "https://gitlab.com/ihrz/ihrz#readme",
	"dependencies": {
		"bufferutil": "^4.0.9",
		"discord-html-transcripts": "^3.2.0",
		"discord-rebackup": "^4.1.0",
		"discord.js": "^14.21.0",
		"dotenv": "^17.2.1",
		"gifwrap": "^0.10.1",
		"horizon.db": "^1.1.4",
		"jimp": "0.22.12",
		"js-yaml": "^4.1.0",
		"jszip": "^3.10.1",
		"lavalink-client": "^2.5.8",
		"pallas-db": "^1.5.2",
		"puppeteer": "^24.15.0",
		"redis": "^5.6.1",
		"typescript-eslint": "^8.38.0",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"@types/bun": "^1.2.19",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24.1.0",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"eslint": "^9.31.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3"
	}
